-- Shared pgTAP helpers, included with \ir by each *.test.sql file (inside its transaction, so
-- everything here is rolled back). Not a test file itself: pg_prove only runs *.sql.
--
-- tests.create_user()   inserts into auth.users exactly as GoTrue does, so the real sign-up
--                       trigger runs; then (as postgres, the trusted path) applies role/status.
-- tests.authenticate_as() switches to the `authenticated` role with the given JWT claims.
-- tests.as_anon()       switches to the `anon` role.
-- tests.as_service()    switches to `service_role` (what Edge Functions use).
-- tests.reset()         back to postgres for setup and checks.

create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

create or replace function tests.create_user(
  p_email text,
  p_first text default 'Test',
  p_second text default 'User',
  p_role public.user_role default 'LEARNER',
  p_status public.account_status default 'ACTIVE',
  p_provider text default 'email',
  p_user_meta jsonb default null
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
  v_meta jsonb := coalesce(
    p_user_meta,
    case when p_provider = 'google'
      then jsonb_build_object('given_name', p_first, 'family_name', p_second, 'email', p_email)
      else jsonb_build_object('first_name', p_first, 'second_name', p_second)
    end
  );
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email,
    '', now(),
    jsonb_build_object('provider', p_provider, 'providers', jsonb_build_array(p_provider)),
    v_meta, now(), now()
  );
  if p_role <> 'LEARNER' or p_status <> 'ACTIVE' then
    update public.profiles
       set role = p_role,
           account_status = p_status,
           can_create_courses = (p_role = 'LECTURER')
     where id = v_id;
  end if;
  return v_id;
end;
$$;

-- An auth session as GoTrue records it, plus the app's last-activity mark (D32). Defaults: fresh.
create or replace function tests.make_session(
  p_user uuid,
  p_started interval default interval '0',
  p_idle interval default interval '0',
  p_aal text default 'aal1'
) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.sessions (id, user_id, created_at, updated_at, aal)
  values (v_id, p_user, now() - p_started, now() - p_started, p_aal::auth.aal_level);
  insert into private.session_activity (session_id, user_id, last_seen_at)
  values (v_id, p_user, now() - p_idle);
  return v_id;
end;
$$;

-- Signs in as p_user. Without p_session a fresh session is created, so each switch is a new session.
create or replace function tests.authenticate_as(p_user uuid, p_aal text default 'aal1', p_session uuid default null)
returns void
language plpgsql
as $$
declare
  v_session uuid := coalesce(p_session, tests.make_session(p_user, p_aal => p_aal));
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', p_user, 'role', 'authenticated', 'aal', p_aal, 'session_id', v_session)::text,
    true
  );
end;
$$;

create or replace function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', jsonb_build_object('role', 'anon')::text, true);
end;
$$;

create or replace function tests.as_service() returns void language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', jsonb_build_object('role', 'service_role')::text, true);
end;
$$;

create or replace function tests.reset() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
