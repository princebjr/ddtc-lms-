{
  "name": "ddtc-lms",
  "private": true,
  "version": "0.0.0",
  "description": "DDTC LMS: learning management system for Dynamic Discipleship Training Centre",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:functions": "vitest run --config vitest.functions.config.js",
    "db:start": "supabase start -x realtime,imgproxy,studio,postgres-meta,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.d.ts",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/auth-js": "2.119.0",
    "@supabase/postgrest-js": "2.119.0",
    "@supabase/storage-js": "2.119.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "4.3.1",
    "zod": "^4.6.7"
  }
}
