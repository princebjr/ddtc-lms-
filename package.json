{
  "name": "ddtc-lms",
  "private": true,
  "version": "0.0.0",
  "description": "DDTC LMS: learning management system for Dynamic Discipleship Training Centre",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,studio,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "supabase": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.5"
  }
}
