# Copy to .env.local for local development. Only public values belong here.
# The Supabase service-role key must NEVER appear in this file, in any VITE_ variable,
# or anywhere under src/. Privileged work happens in Edge Functions only (CLAUDE.md section 3).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
